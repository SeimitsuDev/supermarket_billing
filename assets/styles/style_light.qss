/* assets/styles/style_light.qss */
QMainWindow, QDialog, QWidget#LoginWidget { background-color: #f8fafc; color: #0f172a; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
QLabel { color: #334155; }
QLabel#TitleLabel { font-size: 26px; font-weight: 700; color: #0f172a; padding: 10px 0px; }
QLabel#ErrorLabel { color: #dc2626; font-size: 13px; font-weight: bold; }
QLabel#SuccessLabel { color: #16a34a; font-size: 13px; font-weight: bold; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px 12px; color: #0f172a; font-size: 14px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #2563eb; }
QPushButton { background-color: #2563eb; color: white; border: none; border-radius: 6px; padding: 10px 20px; font-size: 14px; font-weight: 600; }
QPushButton:hover { background-color: #1d4ed8; }
QPushButton:pressed { background-color: #1e40af; }
QPushButton#OutlineButton { background-color: transparent; border: 1px solid #cbd5e1; color: #475569; }
QPushButton#OutlineButton:hover { background-color: #f1f5f9; color: #0f172a; }
QPushButton#DangerButton { background-color: #dc2626; color: white; }
QPushButton#DangerButton:hover { background-color: #b91c1c; }
QPushButton#SuccessButton { background-color: #16a34a; color: white; }
QPushButton#SuccessButton:hover { background-color: #15803d; }
QCheckBox { color: #475569; font-size: 14px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 4px; border: 1px solid #cbd5e1; background-color: #ffffff; }
QCheckBox::indicator:checked { background-color: #2563eb; border: 1px solid #2563eb; }

QFrame#DashboardCard { background-color: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; }
QFrame#DashboardCard QLabel#CardTitle { color: #64748b; font-size: 13px; font-weight: 600; text-transform: uppercase; }
QFrame#DashboardCard QLabel#CardValue { color: #0f172a; font-size: 32px; font-weight: 700; }

QTableWidget { background-color: #ffffff; color: #334155; border-radius: 8px; border: 1px solid #e2e8f0; gridline-color: #f1f5f9; selection-background-color: #eff6ff; selection-color: #1d4ed8; outline: none; }
QHeaderView::section { background-color: #f8fafc; color: #64748b; padding: 12px; border: none; border-bottom: 1px solid #e2e8f0; font-weight: 600; font-size: 13px; }
QTableView QTableCornerButton::section { background: #f8fafc; border: none; }

QListView { background-color: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 6px; padding: 4px; font-size: 14px; outline: none; }
QListView::item { padding: 8px 12px; border-radius: 4px; }
QListView::item:hover, QListView::item:selected { background-color: #eff6ff; color: #1d4ed8; }

QFrame#FormFrame, QWidget#RightPanel { background-color: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; }

QComboBox::drop-down { border: none; padding-right: 10px; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 24px; border-radius: 4px; background: #f1f5f9; border: 1px solid #cbd5e1;
}

QStackedWidget { background-color: #f8fafc; }
QFrame#Sidebar { background-color: #1e293b; }
