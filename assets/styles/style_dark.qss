/* assets/styles/style_dark.qss */
QMainWindow, QDialog, QWidget#LoginWidget { background-color: #0f172a; color: #f8fafc; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
QLabel { color: #e2e8f0; }
QLabel#TitleLabel { font-size: 26px; font-weight: 700; color: #f8fafc; padding: 10px 0px; }
QLabel#ErrorLabel { color: #f87171; font-size: 13px; font-weight: bold; }
QLabel#SuccessLabel { color: #4ade80; font-size: 13px; font-weight: bold; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 10px 12px; color: #f8fafc; font-size: 14px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #3b82f6; }
QPushButton { background-color: #2563eb; color: white; border: none; border-radius: 6px; padding: 10px 20px; font-size: 14px; font-weight: 600; }
QPushButton:hover { background-color: #3b82f6; }
QPushButton:pressed { background-color: #1d4ed8; }
QPushButton#OutlineButton { background-color: transparent; border: 1px solid #475569; color: #94a3b8; }
QPushButton#OutlineButton:hover { background-color: #1e293b; color: #f8fafc; }
QPushButton#DangerButton { background-color: #dc2626; color: white; }
QPushButton#DangerButton:hover { background-color: #ef4444; }
QPushButton#SuccessButton { background-color: #16a34a; color: white; }
QPushButton#SuccessButton:hover { background-color: #22c55e; }
QCheckBox { color: #94a3b8; font-size: 14px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 4px; border: 1px solid #334155; background-color: #1e293b; }
QCheckBox::indicator:checked { background-color: #2563eb; border: 1px solid #2563eb; }

QFrame#DashboardCard { background-color: #1e293b; border-radius: 12px; border: 1px solid #334155; }
QFrame#DashboardCard QLabel#CardTitle { color: #94a3b8; font-size: 13px; font-weight: 600; text-transform: uppercase; }
QFrame#DashboardCard QLabel#CardValue { color: #f8fafc; font-size: 32px; font-weight: 700; }

QTableWidget { background-color: #1e293b; color: #e2e8f0; border-radius: 8px; border: 1px solid #334155; gridline-color: #334155; selection-background-color: #334155; selection-color: #3b82f6; outline: none; }
QHeaderView::section { background-color: #0f172a; color: #94a3b8; padding: 12px; border: none; border-bottom: 1px solid #334155; font-weight: 600; font-size: 13px; }
QTableView QTableCornerButton::section { background: #0f172a; border: none; }

QListView { background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 6px; padding: 4px; font-size: 14px; outline: none; }
QListView::item { padding: 8px 12px; border-radius: 4px; }
QListView::item:hover, QListView::item:selected { background-color: #334155; color: #3b82f6; }

QFrame#FormFrame, QWidget#RightPanel { background-color: #1e293b; border-radius: 12px; border: 1px solid #334155; }

QComboBox::drop-down { border: none; padding-right: 10px; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 24px; border-radius: 4px; background: #334155; border: 1px solid #475569;
}

QStackedWidget { background-color: #0f172a; }
QFrame#Sidebar { background-color: #020617; }
